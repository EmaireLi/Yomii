# Yomii 后端环境配置示例
# 复制此文件为 .env 并填写实际值

# 应用配置
APP_NAME=Yomii API
APP_VERSION=1.0.0
DEBUG=true

# SQLite 配置 (词典数据)
SQLITE_DATABASE_PATH=data/dictionary.db

# MySQL 配置 (用户行为数据)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=yomii

# JWT 配置
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 配置 (用逗号分隔)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI 服务配置（可选）
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4

# 作文双模型服务配置（本地 8GB 方案）
ESSAY_SCORE_MODEL_URL=http://127.0.0.1:8011/infer
ESSAY_SCORE_MODEL_NAME=qwen3-1.7b-score-lora
ESSAY_REVISION_MODEL_URL=http://127.0.0.1:8012/infer
ESSAY_REVISION_MODEL_NAME=qwen3-1.7b-revision-lora
ESSAY_MODEL_TIMEOUT_SECONDS=45
