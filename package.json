{
  "name": "yomii",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "npm run build:electron && node electron/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node ./electron/rename.cjs",
    "build": "run-p type-check build-frontend --",
    "build-frontend": "vite build",
    "build:full": "npm run build && npm run build:electron && electron-builder",
    "build:win": "npm run build && npm run build:electron && electron-builder --win",
    "build:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "canvas-nest.js": "^2.0.1",
    "element-plus": "^2.13.5",
    "vue": "^3.5.29",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.yomii.app",
    "productName": "Yomii",
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
