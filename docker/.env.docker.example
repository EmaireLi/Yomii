# Copy this file to ../.env.docker before running docker compose from the project root.

# =====================
# Backend App
# =====================
APP_NAME=Yomii API
APP_VERSION=1.0.0
DEBUG=false
SQL_ECHO=false
SECRET_KEY=change-this-in-docker-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =====================
# Database
# =====================
SQLITE_DATABASE_PATH=backend/data/dictionary.db
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=yomii

# =====================
# Optional AI Provider
# =====================
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4

# =====================
# DeepSeek Fallback
# =====================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# =====================
# Essay Model Services
# =====================
ESSAY_SCORE_MODEL_URL=http://score-model:8011/infer
ESSAY_SCORE_MODEL_NAME=qwen3-1.7b-score-merged
ESSAY_REVISION_MODEL_URL=http://revision-model:8012/infer
ESSAY_REVISION_MODEL_NAME=qwen3-1.7b-revision-merged
ESSAY_MODEL_TIMEOUT_SECONDS=180
